{
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.cargo.features": "all",
    "editor.formatOnSave": true,
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "files.watcherExclude": {
        "**/target/**": true
    },
    "search.exclude": {
        "**/target": true
    },
    "chat.tools.terminal.autoApprove": {
        "just": true,
        "cargo tree": true,
        "cargo test": true,
        "cargo fmt": true,
        "git remote": true,
        "git add": true,
        "git commit": true
    }
}
